# Local development only. Never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Runtime database: use the Supabase Session/Direct connection string (port 5432)
# for a local backend. For Vercel, use the Transaction pooler (port 6543).
# Copy the exact URI from Supabase Dashboard -> Project Settings -> Database.
# Example:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<session-pooler-host>:5432/postgres
DATABASE_URL=

# One-time seed/import: direct/session connection (port 5432). Used by
# `python -m scripts.sync_supabase`. Never use the transaction pooler here.
SUPABASE_DATABASE_URL=

# Local PostGIS is only needed for pytest/offline development, not to run the backend.
TEST_DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5433/argus_test

CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Supabase (Phase 2+). SUPABASE_URL must be set for JWT verification; issuer and JWKS URL are derived.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUD=authenticated

# Management API only (auth email templates). Never ship this to the app.
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Storage (Phase 4). Service key is server-only; leave empty to forward the caller's token (RLS-scoped).
EVIDENCE_BUCKET=evidence
AVATAR_BUCKET=avatars
MAX_IMAGE_BYTES=1048576
SIGNED_URL_TTL_SECONDS=3600

# Reverse geocoding (OSM Nominatim). Set a real contact URL/email in the User-Agent
# per https://operations.osmfoundation.org/policies/nominatim/ before production.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=ArgusPanoptes/0.1
GEOCODER_TIMEOUT_SECONDS=8

# Tile proxy (development/demo). Add a contact before production.
TILE_USER_AGENT=CivicApp/2.0
TILE_CACHE_SECONDS=86400
