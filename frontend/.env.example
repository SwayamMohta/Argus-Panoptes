# Public client configuration only. EXPO_PUBLIC_* values are compiled into the app bundle.
# Use the PC's LAN IP (not localhost) when testing in Expo Go on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Supabase public project configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional raster tile template containing {z}/{x}/{y}. Defaults to CARTO Voyager.
# Use a licensed or self-hosted provider for production.
EXPO_PUBLIC_TILE_URL=
